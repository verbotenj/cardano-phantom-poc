# CARDANO PHANTOM INTEGRATION - DEVELOPER ENVIRONMENT TEMPLATE
# Copy this file to '.env.development' and populate the values below

LOCAL_DEV_NETWORK=demeter-preview

# Your Dedicated Demeter.run Blockfrost API Endpoint URL
# 1. Log in to demeter.run and create a Cardano Preview project
# 2. Enable "Blockfrost API" under Extensions
# 3. Paste the provided URL below (Ensure NO trailing slash)
DEMETER_BLOCKFROST_URL=https://cardano-preview.blockfrost-m1.demeter.run

# Your Demeter Access Token / Blockfrost API Key
# 1. Retrieve the Blockfrost API Key from your Demeter Workspace
# 2. Paste the token below
DEMETER_API_KEY=your_demeter_api_key_here

# BIP-39 Seed Phrase for Cardano Wallet 1 (Sender - Must be funded with tADA)
CARDANO_MNEMONIC="your twelve or twenty-four word seed phrase here"
CARDANO_ADDRESS_1="addr_test1..."

# BIP-39 Seed Phrase for Cardano Wallet 2 (Receiver - Receives the E2E transfers)
CARDANO_MNEMONIC_2="your second twelve or twenty-four word seed phrase here"
CARDANO_ADDRESS_2="addr_test1..."
